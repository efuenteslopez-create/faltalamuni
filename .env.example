# FLM — Variables de entorno (ejemplo, sin valores reales)
# Copia a .env.local y completa. Nunca subas valores reales al repo.

# Secreto para firmar cookies de sesión (mínimo 32 caracteres aleatorios).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FLM_SESSION_SECRET=

# Directorio donde el adaptador demo persiste data/db.json (JSON con escritura atómica).
# Por defecto: ./.data (ignorado por git). En producción migrar a Supabase/PostGIS.
FLM_DATA_DIR=

# URL pública de la app (para links compartidos, Open Graph, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Tiles del mapa (MapLibre GL JS). Compatible con cualquier proveedor XYZ / OSM.
# Ejemplo OSM estándar (respeta su política de uso) u otro proveedor con API key.
NEXT_PUBLIC_MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors

# Activa datos y usuarios de demostración claramente etiquetados (true/false).
# En producción debe ser false.
FLM_DEMO_MODE=true

# Regla de consenso para verificación ciudadana (nº de vecinos independientes).
FLM_VERIFICATION_QUORUM=3
